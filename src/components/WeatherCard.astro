---
const forecastSlots = [0, 1, 2];
---

<section class="section-pad bg-river-light/45" aria-labelledby="love-river-weather">
  <div class="site-shell">
    <article class="weather-card" data-weather-card aria-busy="true">
      <header class="weather-heading">
        <div>
          <h2 id="love-river-weather">愛河現在的天氣</h2>
          <p>固定查詢愛河市區段周邊，提供目前體感與三日預報。</p>
        </div>
        <p class="weather-live" data-weather-live aria-live="polite">
          <span aria-hidden="true"></span>
          <b data-weather-live-text>正在取得資料</b>
        </p>
      </header>

      <div class="weather-shell">
        <div class="weather-loading" data-weather-loading>
          <span class="weather-spinner" aria-hidden="true"></span>
          <div>
            <strong>天氣資料載入中</strong>
            <p>正在取得愛河周邊天氣資料。</p>
          </div>
        </div>

        <div class="weather-content" data-weather-content hidden>
          <div class="weather-summary">
            <div class="weather-current">
              <span class="weather-icon" aria-hidden="true" data-weather-icon>🌤️</span>
              <div>
                <p class="weather-condition" data-weather-condition>--</p>
                <div class="weather-temperature">
                  <strong data-weather-temperature>--°</strong>
                  <span>體感 <b data-weather-apparent>--°</b></span>
                </div>
              </div>
            </div>

            <div class="weather-advice" data-weather-advice data-level="good">
              <span class="weather-advice-dot" aria-hidden="true"></span>
              <div>
                <strong data-weather-advice-title>正在整理行程提醒</strong>
                <p data-weather-advice-text>請稍候。</p>
              </div>
            </div>
          </div>

          <dl class="weather-metrics">
            <div><dt>今日高／低</dt><dd data-weather-range>--°／--°</dd></div>
            <div><dt>最高降雨機率</dt><dd data-weather-rain>--%</dd></div>
            <div><dt>目前風速</dt><dd data-weather-wind>-- km/h</dd></div>
            <div><dt>今日最大陣風</dt><dd data-weather-gust>-- km/h</dd></div>
          </dl>

          <ul class="weather-days" aria-label="三日天氣預報">
            {
              forecastSlots.map(() => (
                <li data-weather-day>
                  <div>
                    <strong data-weather-day-label>--</strong>
                    <span data-weather-day-condition>🌤️ --</span>
                  </div>
                  <div>
                    <strong data-weather-day-temperature>--°／--°</strong>
                    <span data-weather-day-rain>降雨 --%</span>
                  </div>
                </li>
              ))
            }
          </ul>

          <footer class="weather-footer">
            <p>預報僅供行程參考；遊船停航與水岸管制請以現場或營運單位公告為準。</p>
            <p>
              資料來源：<a href="https://open-meteo.com/" target="_blank" rel="noopener" data-weather-source>Open-Meteo</a>
            </p>
          </footer>
        </div>

        <div class="weather-error" data-weather-error hidden>
          <span aria-hidden="true">!</span>
          <div>
            <strong>暫時無法取得天氣資料</strong>
            <p>
              請稍後再試，或直接查看<a href="https://www.cwa.gov.tw/" target="_blank" rel="noopener">中央氣象署</a>。
            </p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  interface WeatherDay {
    label: string;
    icon: string;
    condition: string;
    maxTemperature: number;
    minTemperature: number;
    precipitationProbability: number;
    maxWindGust: number;
  }

  interface WeatherResponse {
    current: {
      icon: string;
      condition: string;
      weatherCode: number;
      isDay: boolean;
      temperature: number;
      apparentTemperature: number;
      windSpeed: number;
    };
    today: WeatherDay;
    daily: WeatherDay[];
    advice: {
      level: "good" | "watch" | "avoid";
      title: string;
      text: string;
    };
    source: {
      name: string;
      url: string;
    };
  }

  document.querySelectorAll<HTMLElement>("[data-weather-card]").forEach((card) => {
    const loading = card.querySelector<HTMLElement>("[data-weather-loading]");
    const content = card.querySelector<HTMLElement>("[data-weather-content]");
    const error = card.querySelector<HTMLElement>("[data-weather-error]");

    const setText = (selector: string, value: string) => {
      const element = card.querySelector(selector);
      if (element) element.textContent = value;
    };

    fetch("/api/weather", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("Weather request failed");
        return response.json();
      })
      .then((weather: WeatherResponse) => {
        const thunder = [82, 95, 96, 99].includes(weather.current.weatherCode);
        setText("[data-weather-icon]", weather.current.icon);
        setText("[data-weather-temperature]", `${Math.round(weather.current.temperature)}°`);
        setText(
          "[data-weather-condition]",
          `${weather.current.isDay ? "日間" : "夜間"} · ${thunder ? "雷雨警示" : weather.current.condition}`,
        );
        setText("[data-weather-apparent]", `${Math.round(weather.current.apparentTemperature)}°`);
        setText(
          "[data-weather-range]",
          `${Math.round(weather.today.maxTemperature)}°／${Math.round(weather.today.minTemperature)}°`,
        );
        setText(
          "[data-weather-rain]",
          `${Math.round(weather.today.precipitationProbability)}%`,
        );
        setText("[data-weather-wind]", `${Math.round(weather.current.windSpeed)} km/h`);
        setText("[data-weather-gust]", `${Math.round(weather.today.maxWindGust)} km/h`);
        setText("[data-weather-advice-title]", weather.advice.title);
        setText("[data-weather-advice-text]", weather.advice.text);
        setText(
          "[data-weather-live-text]",
          `${weather.current.isDay ? "日間" : "夜間"}即時資料`,
        );

        const advice = card.querySelector<HTMLElement>("[data-weather-advice]");
        if (advice) advice.dataset.level = weather.advice.level;

        const source = card.querySelector<HTMLAnchorElement>("[data-weather-source]");
        if (source) {
          source.textContent = weather.source.name;
          source.href = weather.source.url;
        }

        card.querySelectorAll<HTMLElement>("[data-weather-day]").forEach((item, index) => {
          const day = weather.daily[index];
          if (!day) return;

          const write = (selector: string, value: string) => {
            const element = item.querySelector(selector);
            if (element) element.textContent = value;
          };

          write("[data-weather-day-label]", day.label);
          write("[data-weather-day-condition]", `${day.icon} ${day.condition}`);
          write(
            "[data-weather-day-temperature]",
            `${Math.round(day.maxTemperature)}°／${Math.round(day.minTemperature)}°`,
          );
          write(
            "[data-weather-day-rain]",
            `降雨 ${Math.round(day.precipitationProbability)}%`,
          );
        });

        if (loading) loading.hidden = true;
        if (error) error.hidden = true;
        if (content) content.hidden = false;
        card.setAttribute("aria-busy", "false");
      })
      .catch(() => {
        if (loading) loading.hidden = true;
        if (content) content.hidden = true;
        if (error) error.hidden = false;
        setText("[data-weather-live-text]", "資料暫時無法取得");
        card.setAttribute("aria-busy", "false");
      });
  });
</script>

<style>
  .weather-card {
    width: 100%;
  }

  .weather-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .weather-heading h2 {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2rem, 4.5vw, 3.65rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .weather-heading > div > p {
    margin: 0.75rem 0 0;
    color: rgb(18 38 58 / 0.7);
    line-height: 1.75;
  }

  .weather-live {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    border: 1px solid rgb(18 103 122 / 0.18);
    border-radius: 999px;
    padding: 0.55rem 0.8rem;
    color: var(--color-river);
    background: rgb(255 255 255 / 0.65);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .weather-live span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #3c9b71;
    box-shadow: 0 0 0 0.25rem rgb(60 155 113 / 0.13);
  }

  .weather-live b {
    font: inherit;
  }

  .weather-shell {
    overflow: hidden;
    border: 1px solid rgb(9 38 58 / 0.1);
    border-radius: 2rem;
    background: white;
    box-shadow: 0 2rem 5rem rgb(6 27 42 / 0.09);
  }

  .weather-loading,
  .weather-error {
    display: flex;
    min-height: 17rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    color: rgb(18 38 58 / 0.65);
  }

  .weather-loading[hidden],
  .weather-error[hidden],
  .weather-content[hidden] {
    display: none;
  }

  .weather-loading strong,
  .weather-error strong {
    color: var(--color-navy);
  }

  .weather-loading p,
  .weather-error p {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .weather-spinner {
    width: 2.65rem;
    height: 2.65rem;
    border: 4px solid var(--color-river-light);
    border-top-color: var(--color-river);
    border-radius: 999px;
    animation: weather-spin 0.9s linear infinite;
  }

  .weather-error > span {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 999px;
    color: #8b2f24;
    background: rgb(173 71 56 / 0.1);
    font-weight: 900;
  }

  .weather-error a,
  .weather-footer a {
    color: var(--color-river);
    font-weight: 800;
  }

  .weather-summary {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: stretch;
  }

  .weather-current {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 1.2rem;
    padding: 2rem;
    color: white;
    background:
      radial-gradient(circle at 15% 10%, rgb(233 184 97 / 0.2), transparent 13rem),
      var(--color-navy);
  }

  .weather-icon {
    font-size: clamp(3.6rem, 7vw, 5.2rem);
    line-height: 1;
    filter: drop-shadow(0 0.5rem 0.8rem rgb(0 0 0 / 0.16));
  }

  .weather-condition {
    margin: 0 0 0.2rem;
    color: rgb(255 255 255 / 0.68);
    font-size: 0.85rem;
    font-weight: 750;
  }

  .weather-temperature {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .weather-temperature > strong {
    font-size: clamp(3.2rem, 6vw, 5rem);
    font-weight: 850;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .weather-temperature span {
    color: rgb(255 255 255 / 0.65);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .weather-temperature b {
    color: white;
  }

  .weather-advice {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2.25rem;
    background: #f0f8f6;
  }

  .weather-advice-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: #3c9b71;
    box-shadow: 0 0 0 0.35rem rgb(60 155 113 / 0.14);
  }

  .weather-advice strong {
    color: var(--color-navy);
    font-size: 1.05rem;
  }

  .weather-advice p {
    margin: 0.35rem 0 0;
    color: rgb(18 38 58 / 0.68);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .weather-advice[data-level="watch"] {
    background: #fff9e8;
  }

  .weather-advice[data-level="watch"] .weather-advice-dot {
    background: #d99a22;
    box-shadow: 0 0 0 0.35rem rgb(217 154 34 / 0.14);
  }

  .weather-advice[data-level="avoid"] {
    background: #fff4f1;
  }

  .weather-advice[data-level="avoid"] .weather-advice-dot {
    background: var(--color-coral);
    box-shadow: 0 0 0 0.35rem rgb(173 71 56 / 0.14);
  }

  .weather-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 1.5rem 2rem;
  }

  .weather-metrics div {
    border-radius: 1rem;
    padding: 0.9rem 1rem;
    background: var(--color-cream);
  }

  .weather-metrics dt {
    color: rgb(18 38 58 / 0.58);
    font-size: 0.7rem;
  }

  .weather-metrics dd {
    margin: 0.25rem 0 0;
    color: var(--color-navy);
    font-size: 1rem;
    font-weight: 850;
  }

  .weather-days {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid rgb(9 38 58 / 0.1);
    padding: 0;
    list-style: none;
  }

  .weather-days li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-right: 1px solid rgb(9 38 58 / 0.1);
    padding: 1.15rem 1.5rem;
  }

  .weather-days li:last-child {
    border-right: 0;
  }

  .weather-days li > div {
    display: grid;
  }

  .weather-days li > div:last-child {
    text-align: right;
  }

  .weather-days strong {
    color: var(--color-navy);
    font-size: 0.86rem;
  }

  .weather-days span {
    margin-top: 0.15rem;
    color: rgb(18 38 58 / 0.58);
    font-size: 0.7rem;
  }

  .weather-days li > div:last-child span {
    color: var(--color-river);
    font-weight: 750;
  }

  .weather-footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgb(9 38 58 / 0.1);
    padding: 0.8rem 1.5rem;
    color: rgb(18 38 58 / 0.55);
    background: #fafbf9;
    font-size: 0.69rem;
    line-height: 1.6;
  }

  .weather-footer p {
    margin: 0;
  }

  @keyframes weather-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 52rem) {
    .weather-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .weather-summary {
      grid-template-columns: 1fr;
    }

    .weather-metrics {
      grid-template-columns: repeat(2, 1fr);
    }

    .weather-days {
      grid-template-columns: 1fr;
    }

    .weather-days li {
      border-right: 0;
      border-bottom: 1px solid rgb(9 38 58 / 0.1);
    }

    .weather-days li:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 32rem) {
    .weather-shell {
      border-radius: 1.5rem;
    }

    .weather-current {
      gap: 0.8rem;
      padding: 1.5rem 1.25rem;
    }

    .weather-icon {
      font-size: 3.2rem;
    }

    .weather-temperature > strong {
      font-size: 3.35rem;
    }

    .weather-advice {
      padding: 1.5rem 1.25rem;
    }

    .weather-metrics {
      gap: 0.5rem;
      padding: 1rem;
    }

    .weather-metrics div {
      padding: 0.8rem;
    }

    .weather-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-spinner {
      animation-duration: 1.8s;
    }
  }
</style>
