---
/**
 * 即時氣象模組的靜態骨架（server island 的 fallback）。
 * 在伺服器端資料尚未回傳前顯示，維持版面不跳動。
 */
---

<section class="bg-cream py-14 sm:py-16" aria-label="愛河即時氣象">
  <div class="site-shell">
    <div class="rounded-3xl border border-navy/10 bg-white p-6 shadow-[0_1.5rem_4rem_rgba(6,27,42,.07)] sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-[0.68rem] font-extrabold tracking-[0.18em] text-river">Live Weather</p>
          <h2 class="mt-2 text-2xl font-extrabold tracking-[-0.03em] text-navy sm:text-3xl">愛河即時氣象與 7 日預報</h2>
        </div>
        <p class="text-xs font-bold text-ink/45">正在取得最新觀測…</p>
      </div>
      <div class="mt-7 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-2xl bg-sand/70 p-6">
          <div class="h-14 w-32 animate-pulse rounded-lg bg-navy/10"></div>
          <div class="mt-4 h-4 w-40 animate-pulse rounded bg-navy/10"></div>
          <div class="mt-6 h-16 w-full animate-pulse rounded-xl bg-navy/10"></div>
        </div>
        <div class="grid grid-cols-4 gap-3 sm:grid-cols-7">
          {
            Array.from({ length: 7 }).map(() => (
              <div class="rounded-2xl border border-navy/10 p-3">
                <div class="h-3 w-10 animate-pulse rounded bg-navy/10"></div>
                <div class="mt-3 h-8 w-8 animate-pulse rounded-full bg-navy/10"></div>
                <div class="mt-3 h-3 w-12 animate-pulse rounded bg-navy/10"></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
