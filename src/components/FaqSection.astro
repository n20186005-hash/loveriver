---
import { faqItems as defaultItems, buildFaqSchema, type FaqItem } from "../data/faq";

interface Props {
  items?: FaqItem[];
  title?: string;
  description?: string;
  emitSchema?: boolean;
  /** 頁尾補充文字；傳 null 可整段隱藏（英文頁面等無中文導流需求時使用）。 */
  footNote?: string | null;
  id?: string;
  tone?: "cream" | "sand" | "light";
}

const {
  items = defaultItems,
  title = "Love River 愛河常見問題",
  description = "出發前最常被問到的問題，先回答，再展開細節。",
  emitSchema = true,
  footNote,
  id = "faq",
  tone = "cream",
} = Astro.props;

const toneClass = {
  cream: "bg-cream",
  sand: "bg-sand",
  light: "bg-river-light",
}[tone];

const schema = emitSchema ? buildFaqSchema(items) : undefined;
---

<section class:list={["section-pad", toneClass]} aria-labelledby={`${id}-title`} id={id}>
  <div class="site-shell">
    <div class="max-w-2xl">
      <p class="text-[0.68rem] font-extrabold tracking-[0.18em] text-river">FAQ</p>
      <h2 id={`${id}-title`} class="section-title mt-4">{title}</h2>
      <p class="mt-5 text-base leading-8 text-ink/75">{description}</p>
    </div>

    <div class="mt-10 grid gap-3 lg:grid-cols-2">
      {
        items.map((item) => (
          <details class="group rounded-2xl border border-navy/10 bg-white p-5 open:shadow-lg">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-extrabold text-navy">
              <span>{item.question}</span>
              <span class="mt-0.5 shrink-0 text-river transition group-open:rotate-45" aria-hidden="true">
                ＋
              </span>
            </summary>
            <p class="mt-3 text-sm leading-7 text-ink/70">{item.answer}</p>
          </details>
        ))
      }
    </div>

    {
      footNote !== null && (
        <p class="mt-6 text-xs leading-6 text-ink/50">
          {footNote ?? (
            <>
              船班、票價與活動為動態資訊，請以營運單位當日公告為準。更多問答請見
              <a href="/faq/" class="font-extrabold text-river">
                常見問題頁
              </a>
              。
            </>
          )}
        </p>
      )
    }
  </div>
</section>

{
  schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
}
