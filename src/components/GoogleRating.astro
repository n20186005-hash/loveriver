---
import { attraction, type RatingInfo } from "../data/site";

interface Props {
  variant?: "card" | "inline" | "footer";
  showAddress?: boolean;
  showNote?: boolean;
  /** 顯示語言；英文版略過中文分類名稱。 */
  lang?: "zh-Hant-TW" | "en";
  /** 該頁景點自己的 Google 評分；未提供時使用全站愛河評分。 */
  rating?: RatingInfo;
}

const {
  variant = "card",
  showAddress = true,
  showNote = true,
  lang = "zh-Hant-TW",
  rating = attraction.rating,
} = Astro.props;
const isEn = lang === "en";
const { category, addressZh, fullName, localizedName } = attraction;
/** 愛河地址只跟全站愛河評分一起出現，景點頁不借用愛河地址。 */
const showSiteAddress = showAddress && rating === attraction.rating;
const percent = Math.max(0, Math.min(100, (rating.value / rating.bestRating) * 100));
const reviewLabel = rating.reviewCount.toLocaleString("en-US");
const starsLabel = isEn
  ? `Rated ${rating.value} out of ${rating.bestRating} from ${reviewLabel} Google Maps reviews`
  : `Google Maps 使用者評分 ${rating.value} 分（滿分 ${rating.bestRating} 分），共 ${reviewLabel} 則評論`;
---

<div
  class:list={[
    "google-rating",
    `google-rating--${variant}`,
    variant === "card" && "rounded-3xl border border-navy/10 bg-white p-6 shadow-[0_1.5rem_4rem_rgba(6,27,42,.08)]",
  ]}
  data-google-rating
>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="text-3xl font-extrabold tracking-[-0.05em] text-navy" data-rating-value>
      {rating.value.toFixed(1)}
    </p>
    <div class="leading-tight">
      <div
        class="google-stars"
        role="img"
        aria-label={starsLabel}
      >
        <span class="google-stars-track" aria-hidden="true">★★★★★</span>
        <span class="google-stars-fill" aria-hidden="true" style={`width:${percent}%`}>★★★★★</span>
      </div>
      <p class="mt-1 text-xs font-bold text-ink/60">
        <span data-rating-count>{reviewLabel}</span>
        {isEn ? " Google reviews" : ` 則 Google 評論 · ${category}`}
      </p>
    </div>
  </div>

  {
    showSiteAddress && (
      <address class="mt-4 not-italic text-sm leading-6 text-ink/70">
        <span class="font-extrabold text-navy">{fullName}（{localizedName}）</span>
        <br />
        {addressZh}
      </address>
    )
  }

  {
    showNote && (
      <p class:list={["google-rating-note mt-4 text-[0.7rem] leading-5 text-ink/55", variant === "footer" && "mt-3"]}>
        {isEn
          ? `Rating and review count for ${rating.subject} come from `
          : `評分與評論數為「${rating.subject}」於 `}
        <span data-rating-verified>{rating.verifiedLabel}</span>
        {isEn
          ? " verified Google Maps user data, not our own rating. "
          : " 查核之 Google Maps 使用者資料，非本站評分。"}
        <a href={rating.sourceUrl} target="_blank" rel="noopener noreferrer" class="font-extrabold text-river">
          {isEn ? "View source ↗" : "查看來源 ↗"}
        </a>
      </p>
    )
  }
</div>

<style>
  .google-stars {
    position: relative;
    display: inline-block;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .google-stars-track {
    color: rgb(9 38 58 / 0.16);
  }

  .google-stars-fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: #e9b861;
  }

  .google-rating--inline {
    display: inline-flex;
    flex-direction: column;
  }

  .google-rating--footer {
    padding: 0;
  }

  .google-rating--footer .text-3xl {
    color: white;
  }

  .google-rating--footer address,
  .google-rating--footer .text-xs,
  .google-rating--footer .google-rating-note {
    color: rgb(255 255 255 / 0.62);
  }
</style>
