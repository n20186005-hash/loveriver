---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Picture from "../components/Picture.astro";

export async function getStaticPaths() {
  const entries = await getCollection("pages");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const parts = entry.id.replace(/\/index$/, "").split("/");
const sectionLabels: Record<string, string> = {
  areas: "愛河分區",
  boats: "愛河遊船",
  itineraries: "行程路線",
  places: "沿岸景點",
};
const section = parts.length > 1 ? sectionLabels[parts[0]] : undefined;
const pageUrl = `https://loveriver.org/${entry.id.replace(/\/index$/, "")}/`;
const breadcrumbs = [
  { "@type": "ListItem", position: 1, name: "首頁", item: "https://loveriver.org/" },
  ...(section
    ? [{ "@type": "ListItem", position: 2, name: section, item: `https://loveriver.org/${parts[0]}/` }]
    : []),
  {
    "@type": "ListItem",
    position: section ? 3 : 2,
    name: data.title,
    item: pageUrl,
  },
];

const mainSchema =
  data.type === "place"
    ? {
        "@context": "https://schema.org",
        "@type": "TouristAttraction",
        name: data.title,
        description: data.description,
        url: pageUrl,
        image: `https://loveriver.org/images/${data.image}-1280.webp`,
        ...(data.latitude &&
          data.longitude && {
            geo: {
              "@type": "GeoCoordinates",
              latitude: data.latitude,
              longitude: data.longitude,
            },
          }),
        address: data.address,
        touristType: data.tags,
      }
    : data.type === "route"
      ? {
          "@context": "https://schema.org",
          "@type": "TouristTrip",
          name: data.title,
          description: data.description,
          url: pageUrl,
          itinerary: data.tags,
        }
      : {
          "@context": "https://schema.org",
          "@type": "Article",
          headline: data.title,
          description: data.description,
          image: `https://loveriver.org/images/${data.image}-1280.webp`,
          inLanguage: "zh-Hant-TW",
          mainEntityOfPage: pageUrl,
          author: { "@type": "Organization", name: "高雄愛河旅遊指南" },
        };

const schema = [
  mainSchema,
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs,
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={`/images/${data.image}-1280.webp`}
  imageAlt={data.imageAlt}
  keywords={data.keywords}
  pageType="article"
  schema={schema}
>
  <section class="overflow-hidden bg-deep text-white">
    <div class="site-shell py-5">
      <nav class="flex flex-wrap items-center gap-2 text-xs text-white/45" aria-label="麵包屑">
        <a href="/" class="hover:text-white">首頁</a>
        <span aria-hidden="true">/</span>
        {section && <><a href={`/${parts[0]}/`} class="hover:text-white">{section}</a><span aria-hidden="true">/</span></>}
        <span class="text-white/72" aria-current="page">{data.title}</span>
      </nav>
    </div>
    <div class="site-shell grid gap-10 pb-14 pt-8 lg:grid-cols-[1fr_0.78fr] lg:items-center lg:pb-20 lg:pt-12">
      <div>
        <h1 class="max-w-[14ch] text-[clamp(2.6rem,6vw,5rem)] font-extrabold leading-[1.02] tracking-[-0.055em]">{data.title}</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/65 sm:text-lg">{data.summary}</p>
        <div class="mt-7 flex flex-wrap gap-2 text-xs font-bold">
          {data.station && <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2.5">⌖ {data.station}</span>}
          {data.duration && <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2.5">◷ {data.duration}</span>}
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-6 rounded-full bg-river/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.8rem]">
          <Picture name={data.image} alt={data.imageAlt} class="h-full w-full object-cover" loading="eager" fetchpriority="high" width={1280} height={960} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-12 lg:py-20">
    <div class="site-shell grid gap-12 lg:grid-cols-[15rem_minmax(0,46rem)] lg:justify-center lg:gap-16">
      <aside class="hidden lg:block">
        <div class="sticky top-28">
          <p class="text-[0.68rem] font-extrabold tracking-[0.18em] text-river">本頁重點</p>
          <nav class="mt-5 grid gap-1 border-l border-navy/12 pl-4" aria-label="本頁目錄">
            {
              headings
                .filter((heading) => heading.depth === 2)
                .map((heading) => (
                  <a href={`#${heading.slug}`} class="rounded-r-lg px-3 py-2 text-sm font-bold leading-5 text-ink/52 no-underline transition hover:bg-river-light hover:text-river">
                    {heading.text}
                  </a>
                ))
            }
          </nav>
          <div class="mt-8 rounded-2xl bg-river-light p-4 text-xs leading-6 text-ink/62">
            <strong class="block text-navy">資料來源</strong>
            {data.sourceUrl && (
              <a href={data.sourceUrl} target="_blank" rel="noopener" class="mt-2 block font-extrabold text-river">
                {data.sourceLabel ?? "查看官方來源"} ↗
              </a>
            )}
          </div>
        </div>
      </aside>
      <article class="content min-w-0">
        <div class="mb-8 rounded-2xl border border-river/15 bg-river-light/60 p-5 text-base leading-8 text-navy">
          <strong class="mr-2">先說結論</strong>
          {data.summary}
        </div>
        <Content />
        <div class="mt-12 rounded-3xl bg-deep p-6 text-white sm:p-8">
          <h2 class="!mt-0 !text-2xl !text-white">接下來，把路線排進時間裡</h2>
          <p class="!mt-3 text-sm leading-7 text-white/58">先看三區差異，或直接選一條兩小時路線；到現場再開啟地圖導航。</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/areas/love-river-vs-heart-vs-bay/" class="btn-light !text-sm">比較三個區域</a>
            <a href="/itineraries/2-hour/" class="rounded-full border border-white/15 px-4 py-3 text-sm font-extrabold text-white no-underline">兩小時路線 →</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
